<% var cur = currency; var showFin = can('payments.view') && hasFeature('finance'); %>
<%- include('../partials/page-header', { heading: t('Assalamu alaikum, {name}', { name: currentUser.name.split(' ')[0] }), sub: t('Here is how {school} is doing in {period}.', { school: tenant.name, period: periodLabel(data.period) }),
  actions: (can('students.manage') ? '<a class="btn btn-light btn-icon" href="/school/students/new"><i class="bi bi-person-plus"></i>' + t('Add student') + '</a>' : '') +
           (can('attendance.manage') && hasFeature('attendance') ? '<a class="btn btn-light btn-icon" href="/school/attendance"><i class="bi bi-calendar-check"></i>' + t('Take attendance') + '</a>' : '') +
           (can('payments.create') && hasFeature('finance') ? '<a class="btn btn-primary btn-icon" href="/school/finance/payments/new"><i class="bi bi-cash-coin"></i>' + t('Receive payment') + '</a>' : '') }) %>

<div class="row g-3 mb-3">
  <div class="col-6 col-xl-3"><div class="card stat-card">
    <div class="d-flex justify-content-between"><div class="label"><%= t('Students') %></div><div class="stat-icon emerald"><i class="bi bi-people"></i></div></div>
    <div class="value"><%= data.counts.activeStudents %></div>
    <div class="meta"><%= t('{n} registered in total', { n: data.counts.totalStudents }) %></div>
  </div></div>
  <div class="col-6 col-xl-3"><div class="card stat-card">
    <div class="d-flex justify-content-between"><div class="label"><%= t('Teachers & classes') %></div><div class="stat-icon gold"><i class="bi bi-person-badge"></i></div></div>
    <div class="value"><%= data.counts.activeTeachers %> <span class="fs-6 text-muted fw-semibold">/ <%= data.counts.totalClasses === 1 ? t('1 class') : t('{n} classes', { n: data.counts.totalClasses }) %></span></div>
    <div class="meta"><%= t('{n} teachers on record', { n: data.counts.totalTeachers }) %></div>
  </div></div>
  <div class="col-6 col-xl-3"><div class="card stat-card">
    <div class="d-flex justify-content-between"><div class="label"><%= t('Today\'s attendance') %></div><div class="stat-icon blue"><i class="bi bi-calendar-check"></i></div></div>
    <div class="value"><%= data.today.students.rate == null ? '—' : data.today.students.rate + '%' %></div>
    <div class="meta"><%= t('{present} present of {total} marked · {absent} absent', { present: data.today.students.present + data.today.students.late, total: data.today.students.total, absent: data.today.students.absent }) %></div>
  </div></div>
  <div class="col-6 col-xl-3"><div class="card stat-card">
    <div class="d-flex justify-content-between"><div class="label"><%= t('Subscription') %></div><div class="stat-icon <%= access.status === 'active' || access.status === 'trial' ? 'emerald' : 'red' %>"><i class="bi bi-stars"></i></div></div>
    <div class="value fs-5 mt-2"><%- statusBadge(access.status) %></div>
    <div class="meta"><%= subscription ? t('{plan} · until {date}', { plan: subscription.planSnapshot.name, date: fmtDate(subscription.endDate) }) : t('No subscription') %></div>
  </div></div>
</div>

<% if (showFin) { %>
<div class="row g-3 mb-3">
  <div class="col-6 col-xl-3"><div class="card stat-card">
    <div class="label"><%= t('Monthly fee collections') %></div><div class="value"><%= money(data.finance.monthlyFees, cur) %></div>
    <div class="meta"><%= t('Registration fees:') %> <strong><%= money(data.finance.registrationFees, cur) %></strong></div>
  </div></div>
  <div class="col-6 col-xl-3"><div class="card stat-card">
    <div class="label"><%= t('Outstanding balances') %></div><div class="value text-danger"><%= money(data.finance.outstanding, cur) %></div>
    <div class="meta"><%= t('{students} students · {overdue} overdue invoices', { students: data.finance.studentsOwing, overdue: data.finance.overdueCount }) %></div>
  </div></div>
  <div class="col-6 col-xl-3"><div class="card stat-card">
    <div class="label"><%= t('Income vs expenses (month)') %></div><div class="value"><%= money(data.finance.income, cur) %></div>
    <div class="meta"><%= t('Expenses:') %> <strong><%= money(data.finance.expenses, cur) %></strong></div>
  </div></div>
  <div class="col-6 col-xl-3"><div class="card stat-card">
    <div class="label"><%= t('Net balance (month)') %></div><div class="value <%= data.finance.net < 0 ? 'text-danger' : 'text-success' %>"><%= money(data.finance.net, cur) %></div>
    <div class="meta"><%= t('Confirmed income − recorded expenses') %></div>
  </div></div>
</div>

<div class="row g-3 mb-3">
  <div class="col-lg-8"><div class="card h-100">
    <div class="card-header d-flex justify-content-between"><span><%= t('Income & expenses — last 6 months') %></span><a class="small" href="/school/reports/net-balance"><%= t('Net balance report') %></a></div>
    <div class="card-body"><div class="chart-box"><canvas data-chart="chartTrend" aria-label="<%= t('Income and expenses chart') %>"></canvas></div></div>
    <script type="application/json" id="chartTrend"><%- JSON.stringify({ type: 'bar', money: true, currency: cur, labels: data.chart.labels, series: [{ label: t('Income'), data: data.chart.income }, { label: t('Expenses'), data: data.chart.expenses }] }).replace(/</g, '\\u003c') %></script>
  </div></div>
  <div class="col-lg-4"><div class="card h-100">
    <div class="card-header d-flex justify-content-between"><span><%= t('Recent payments') %></span><a class="small" href="/school/finance/payments"><%= t('All') %></a></div>
    <div class="list-group list-group-flush">
      <% if (!data.recentPayments.length) { %><div class="empty-state small"><i class="bi bi-cash"></i><%= t('No payments yet') %></div><% } %>
      <% data.recentPayments.forEach(function (p) { %>
        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="/school/finance/payments/<%= p._id %>">
          <div class="min-w-0"><div class="fw-semibold small text-truncate"><%= p.student ? p.student.fullName : '—' %></div><div class="text-muted" style="font-size:.74rem"><%= fmtDate(p.paymentDate) %> · <%= p.method %></div></div>
          <div class="text-end"><div class="fw-bold small <%= p.status === 'reversed' ? 'text-decoration-line-through text-muted' : '' %>"><%= money(p.amount, cur) %></div></div>
        </a>
      <% }) %>
    </div>
  </div></div>
</div>
<% } %>

<div class="row g-3">
  <div class="col-lg-<%= showFin && data.dueRecurring.length && can('expenses.view') ? '6' : '12' %>"><div class="card h-100">
    <div class="card-header d-flex justify-content-between"><span><%= t('Latest lessons') %></span><% if (can('lessons.view')) { %><a class="small" href="/school/lessons"><%= t('All lessons') %></a><% } %></div>
    <div class="table-responsive"><table class="table table-hover">
      <thead><tr><th><%= t('Date') %></th><th><%= t('Lesson') %></th><th><%= t('Class') %></th><th><%= t('Status') %></th></tr></thead>
      <tbody>
        <% if (!data.recentLessons.length) { %><tr><td colspan="4" class="empty-state"><%= t('No lessons recorded yet') %></td></tr><% } %>
        <% data.recentLessons.forEach(function (l) { %>
          <tr><td><%= fmtDate(l.date) %></td><td><a class="row-link" href="/school/lessons/<%= l._id %>"><%= l.title %></a><div class="small text-muted"><%= t(C.LESSON_CATEGORIES[l.category]) %></div></td><td><%= l.class ? l.class.name : '' %></td><td><%- statusBadge(l.status) %></td></tr>
        <% }) %>
      </tbody>
    </table></div>
  </div></div>
  <% if (showFin && data.dueRecurring.length && can('expenses.view')) { %>
  <div class="col-lg-6"><div class="card h-100">
    <div class="card-header"><%= t('Recurring expenses due') %></div>
    <div class="list-group list-group-flush">
      <% data.dueRecurring.forEach(function (e) { %>
        <div class="list-group-item d-flex justify-content-between"><div><div class="fw-semibold small"><%= e.description %></div><div class="text-muted" style="font-size:.74rem"><%= e.category ? e.category.name : '' %> · <%= t('due {date}', { date: fmtDate(e.recurring.nextDueDate) }) %></div></div><div class="fw-bold small"><%= money(e.amount, cur) %></div></div>
      <% }) %>
    </div>
  </div></div>
  <% } %>
</div>
