<div class="card mx-auto mt-4" style="max-width:620px">
  <div class="card-body p-4 text-center">
    <div class="stat-icon red mx-auto mb-3" style="width:56px;height:56px;font-size:1.5rem"><i class="bi bi-lock"></i></div>
    <h1 class="h4"><%= t('Access restricted') %></h1>
    <p class="text-muted"><%= locals.messageKey ? t(messageKey, locals.messageVars) : t(message) %></p>
    <p class="small text-muted"><%= t('Your school\'s records are kept safe and will be available again as soon as access is restored.') %></p>
    <a class="btn btn-primary" href="/school/subscription"><%= t('Go to subscription') %></a>
  </div>
</div>
