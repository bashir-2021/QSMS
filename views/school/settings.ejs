<%- include('../partials/page-header', { heading: 'School settings' }) %>

<ul class="nav nav-tabs mb-3">
  <% [['profile', 'School profile'], ['fees', 'Fees & payments'], ['numbering', 'Numbering & receipts'], ['lessons', 'Lesson rules'], ['subac', 'Subac deductions'], ['categories', 'Expense categories']].forEach(function (tb) { %>
    <li class="nav-item"><a class="nav-link <%= tab === tb[0] ? 'active' : '' %>" href="?tab=<%= tb[0] %>"><%= t(tb[1]) %></a></li>
  <% }) %>
</ul>

<% if (tab === 'profile') { %>
<form method="post" action="/school/settings/profile?_csrf=<%= csrfToken %>" enctype="multipart/form-data" class="needs-validation" novalidate>
  <div class="row g-3">
    <div class="col-lg-8"><div class="card"><div class="card-body row g-3">
      <%- include('../partials/field', { name: 'name', label: 'School name', value: tenant.name, required: true }) %>
      <%- include('../partials/field', { name: 'country', label: 'Country', value: tenant.country, col: 'col-md-6' }) %>
      <%- include('../partials/field', { name: 'city', label: 'City', value: tenant.city, col: 'col-md-6' }) %>
      <%- include('../partials/field', { name: 'address', label: 'Address', value: tenant.address }) %>
      <%- include('../partials/field', { name: 'phone', label: 'Phone', ftype: 'tel', value: tenant.phone, col: 'col-md-6' }) %>
      <%- include('../partials/field', { name: 'email', label: 'Email', ftype: 'email', value: tenant.email, col: 'col-md-6' }) %>
    </div></div></div>
    <div class="col-lg-4"><div class="card"><div class="card-header"><%= t('Logo') %></div><div class="card-body text-center">
      <img id="logoPreview" class="mb-3 <%= tenant.logo ? '' : 'd-none' %>" style="max-width:140px;max-height:140px" src="<%= tenant.logo ? '/school/files/' + tenant.logo.split('/').pop() : '' %>" alt="">
      <input type="file" class="form-control" name="logo" accept="image/png,image/jpeg,image/webp" data-preview="#logoPreview">
      <div class="form-text"><%= t('Shown on the sidebar, receipts and PDF reports (PNG or JPG recommended).') %></div>
      <button class="btn btn-primary w-100 mt-3" type="submit"><%= t('Save profile') %></button>
    </div></div></div>
  </div>
</form>
<% } else if (tab === 'fees' || tab === 'numbering') { %>
<form method="post" action="/school/settings" class="needs-validation" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="tab" value="<%= tab %>">
  <div class="card"><div class="card-body row g-3">
    <div class="<%= tab === 'fees' ? '' : 'd-none' %> col-12"><div class="row g-3">
      <%- include('../partials/field', { name: 'academicYear', label: 'Academic year', value: s.academicYear, required: true, col: 'col-md-3' }) %>
      <%- include('../partials/field', { name: 'currency', label: 'Currency (ISO code)', value: s.currency, required: true, col: 'col-md-3', attrs: 'maxlength="3" style="text-transform:uppercase"', help: 'Default USD. Changing it does not convert existing amounts.' }) %>
      <%- include('../partials/field', { name: 'registrationFee', label: 'Registration fee', ftype: 'money', value: moneyInput(s.registrationFee), required: true, col: 'col-md-3', currency: s.currency }) %>
      <%- include('../partials/field', { name: 'monthlyFee', label: 'Global monthly fee', ftype: 'money', value: moneyInput(s.monthlyFee), required: true, col: 'col-md-3', currency: s.currency, help: 'Classes can override this.' }) %>
      <%- include('../partials/field', { name: 'billingDueDay', label: 'Monthly bills due on day', ftype: 'number', value: s.billingDueDay, min: 1, max: 28, required: true, col: 'col-md-3' }) %>
      <%- include('../partials/field', { name: 'paymentMethods', label: 'Payment methods (one per line)', ftype: 'textarea', rows: 5, value: (s.paymentMethods || []).join('\n'), required: true, col: 'col-md-9' }) %>
    </div></div>
    <div class="<%= tab === 'numbering' ? '' : 'd-none' %> col-12"><div class="row g-3">
      <div class="col-12 small text-muted"><%= t('Tokens:') %> <code>{YYYY}</code> <%= t('year') %>, <code>{YY}</code>, <code>{MM}</code> <%= t('month') %>, <code>{SEQ:5}</code> <%= t('sequence padded to 5 digits.') %> <%= t('Formats with a year restart numbering every year.') %></div>
      <% ['student', 'teacher', 'invoice', 'receipt', 'payment', 'expense'].forEach(function (k) { %>
        <%- include('../partials/field', { name: 'numbering_' + k, label: k.charAt(0).toUpperCase() + k.slice(1) + ' number format', value: s.numbering[k], col: 'col-md-4' }) %>
      <% }) %>
      <%- include('../partials/field', { name: 'receiptFooter', label: 'Receipt footer text', ftype: 'textarea', value: s.receiptFooter, rows: 2, max: 300 }) %>
    </div></div>
    <div class="col-12 text-end"><button class="btn btn-primary" type="submit"><%= t('Save settings') %></button></div>
  </div></div>
</form>
<% } else if (tab === 'lessons') {
  var lr = lessonRules; var o = locals.old || {};
  var oldLevels = o.levels ? (Array.isArray(o.levels) ? o.levels : Object.keys(o.levels).map(function (k) { return o.levels[k]; })) : null;
  var levels = oldLevels || lr.levels;
  var rows = levels.slice(); while (rows.length < Math.min(C.MAX_HIFZ_LEVELS, levels.length + 2)) rows.push({ label: '', min: '' });
%>
<form method="post" action="/school/settings/lessons" class="needs-validation" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="alert alert-info small"><i class="bi bi-info-circle"></i> <%= t('These rules apply to lessons scored from now on. Results already recorded keep the rules they were scored with.') %></div>
  <div class="row g-3">
    <div class="col-lg-6"><div class="card h-100"><div class="card-header"><%= t('Warnings and scoring') %></div><div class="card-body row g-3">
      <div class="col-12 small text-muted"><%= t('Every lesson that is listened to starts at {base} points. Each warning removes points; reaching the warning limit returns the lesson to be repeated.', { base: C.LESSON_SCORE_BASE }) %></div>
      <%- include('../partials/field', { name: 'maxWarnings', label: 'Warnings before the lesson is returned', ftype: 'number', value: lr.maxWarnings, min: 1, max: 100, step: 1, required: true, col: 'col-md-6' }) %>
      <%- include('../partials/field', { name: 'pointsPerWarning', label: 'Points removed per warning', ftype: 'number', value: lr.pointsPerWarning, min: 0, max: 100, step: 0.5, required: true, col: 'col-md-6' }) %>
      <%- include('../partials/field', { name: 'returnBelowScore', label: 'Also return lessons scoring below', ftype: 'number', value: lr.returnBelowScore, min: 0, max: 100, step: 1, col: 'col-md-6', help: '0 = off. Only the warning limit returns a lesson.' }) %>
      <div class="col-md-6"><div class="small text-muted mb-1"><%= t('With the saved rules') %></div><ul class="small mb-0 ps-3">
        <% for (var w = 1; w <= Math.min(lr.maxWarnings, 6); w++) { var sc = Math.max(0, Math.round((C.LESSON_SCORE_BASE - w * lr.pointsPerWarning) * 100) / 100); %>
          <li><%= w === 1 ? t('1 warning') : t('{n} warnings', { n: w }) %> = <%= sc %>/<%= C.LESSON_SCORE_BASE %><% if (w >= lr.maxWarnings) { %> — <strong><%= t('lesson returned') %></strong><% } %></li>
        <% } %>
      </ul></div>
      <%- include('../partials/field', { name: 'lessonTypes', label: 'Lesson types (one per line)', ftype: 'textarea', rows: 4, value: lr.types.map(function (x) { return t(x); }).join('\n'), required: true, max: 2000 }) %>
    </div></div></div>
    <div class="col-lg-6"><div class="card h-100"><div class="card-header"><%= t('Hifz levels') %></div><div class="card-body">
      <div class="small text-muted mb-2"><%= t('A score gets the highest level whose starting score it reaches. The lowest level must start at 0; it is also used for lessons that are returned or waiting to be listened to.') %></div>
      <div class="table-responsive"><table class="table table-sm align-middle mb-0">
        <thead><tr><th><%= t('Level name') %></th><th style="width:9rem"><%= t('From score') %></th></tr></thead>
        <tbody>
          <% rows.forEach(function (l, i) { %>
            <tr>
              <td><input class="form-control form-control-sm" name="levels[<%= i %>][label]" value="<%= oldLevels ? l.label : t(l.label) %>" maxlength="60" aria-label="<%= t('Level name') %>"></td>
              <td><input class="form-control form-control-sm" type="number" name="levels[<%= i %>][min]" value="<%= l.min %>" min="0" max="100" step="1" aria-label="<%= t('From score') %>"></td>
            </tr>
          <% }) %>
        </tbody>
      </table></div>
      <div class="form-text"><%= t('Leave a row empty to remove it.') %></div>
    </div></div></div>
    <div class="col-12 text-end"><button class="btn btn-primary" type="submit"><%= t('Save lesson rules') %></button></div>
  </div>
</form>
<% } else if (tab === 'subac') { %>
<form method="post" action="/school/settings/subac" class="needs-validation" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="card"><div class="card-header"><%= t('Points lost per occurrence') %></div><div class="card-body row g-3">
    <div class="col-12 small text-muted"><%= t('Each student starts a Subac at {base} points. New sessions use these values; sessions already created keep the values they started with.', { base: C.SUBAC_BASE_SCORE }) %></div>
    <% Object.keys(C.SUBAC_DEDUCTIONS).forEach(function (key) { %>
      <%- include('../partials/field', { name: key, label: C.SUBAC_DEDUCTIONS[key].label, ftype: 'number', value: s.subacDeductions[key], min: 0, max: 100, step: 0.25, required: true, col: 'col-md-4' }) %>
    <% }) %>
    <div class="col-12 text-end"><button class="btn btn-primary" type="submit"><%= t('Save settings') %></button></div>
  </div></div>
</form>
<% } else { %>
<div class="row g-3">
  <div class="col-lg-8"><div class="card"><div class="table-responsive"><table class="table">
    <thead><tr><th><%= t('Category') %></th><th><%= t('Description') %></th><th><%= t('Status') %></th><th></th></tr></thead>
    <tbody>
      <% categories.forEach(function (c) { %>
        <tr>
          <td class="fw-semibold"><%= c.name %><% if (c.isSystem) { %> <span class="badge badge-soft-info"><%= t('System') %></span><% } %></td>
          <td class="small text-muted"><%= c.description || '' %></td><td><%- statusBadge(c.isActive ? 'active' : 'inactive') %></td>
          <td class="text-end text-nowrap">
            <% if (!c.isSystem) { %>
              <form method="post" action="/school/settings/categories/<%= c._id %>" class="d-inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="name" value="<%= c.name %>"><input type="hidden" name="description" value="<%= c.description || '' %>"><input type="hidden" name="isActive" value="<%= c.isActive ? '' : 'on' %>"><button class="btn btn-sm btn-light" type="submit"><%= t(c.isActive ? 'Deactivate' : 'Activate') %></button></form>
              <form method="post" action="/school/settings/categories/<%= c._id %>/delete" class="d-inline" data-confirm="<%= t('Delete category {name}? Categories with expenses cannot be deleted.', { name: c.name }) %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-light text-danger" type="submit"><i class="bi bi-trash"></i></button></form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table></div></div></div>
  <div class="col-lg-4"><div class="card"><div class="card-header"><%= t('Add category') %></div><div class="card-body">
    <form method="post" action="/school/settings/categories" class="row g-2">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <%- include('../partials/field', { name: 'name', label: 'Name', required: true }) %>
      <%- include('../partials/field', { name: 'description', label: 'Description' }) %>
      <div class="col-12"><button class="btn btn-primary w-100" type="submit"><%= t('Add category') %></button></div>
    </form>
  </div></div></div>
</div>
<% } %>
