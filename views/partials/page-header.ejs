<div class="page-header">
  <div>
    <% if (locals.crumbs) { %><div class="crumbs"><% crumbs.forEach(function (c, i) { %><% if (i) { %> / <% } %><% if (c[1]) { %><a href="<%= c[1] %>"><%= t(c[0]) %></a><% } else { %><%= t(c[0]) %><% } %><% }) %></div><% } %>
    <h1><%= t(heading) %></h1>
    <% if (locals.sub) { %><div class="text-muted small mt-1"><%= t(sub) %></div><% } %>
  </div>
  <% if (locals.actions) { %><div class="actions"><%- actions %></div><% } %>
</div>
