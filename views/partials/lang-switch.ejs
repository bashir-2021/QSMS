<div class="dropdown">
  <button class="btn btn-light <%= locals.compact ? 'btn-sm' : '' %> dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="<%= t('Language') %>">
    <i class="bi bi-translate"></i><span class="<%= locals.compact ? '' : 'd-none d-sm-inline' %> ms-1"><%= LANGS[lang].name %></span>
  </button>
  <ul class="dropdown-menu dropdown-menu-end shadow-sm">
    <% Object.keys(LANGS).forEach(function (code) { %>
      <li><a class="dropdown-item <%= code === lang ? 'active' : '' %>" href="/lang/<%= code %>" lang="<%= code %>" dir="<%= LANGS[code].dir %>"><%= LANGS[code].name %></a></li>
    <% }) %>
  </ul>
</div>
