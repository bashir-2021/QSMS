<% (locals.flash || []).forEach(function (f) { %>
  <div class="alert alert-<%= f.type === 'danger' ? 'danger' : f.type === 'warning' ? 'warning' : f.type === 'info' ? 'info' : 'success' %> alert-dismissible fade show d-flex gap-2 align-items-start" role="alert">
    <i class="bi bi-<%= f.type === 'danger' ? 'exclamation-octagon' : f.type === 'warning' ? 'exclamation-triangle' : f.type === 'info' ? 'info-circle' : 'check-circle' %> mt-1"></i>
    <div><%= t(f.message) %></div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t('Close') %>"></button>
  </div>
<% }) %>
