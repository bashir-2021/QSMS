<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius:16px">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title" data-confirm-title>Please confirm</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="mb-2" data-confirm-text></p>
        <div class="d-none" data-reason-wrap>
          <label class="form-label required" for="confirmReason">Reason (kept in the audit log)</label>
          <textarea class="form-control" id="confirmReason" rows="2" maxlength="300"></textarea>
          <div class="invalid-feedback">Please give a reason (at least 3 characters).</div>
        </div>
      </div>
      <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" data-confirm-ok>Confirm</button>
      </div>
    </div>
  </div>
</div>
