<% var tn = tenant; var sub = tn.currentSubscription; %>
<%- include('../partials/page-header', { heading: tn.name, crumbs: [['Schools', '/platform/schools'], [tn.name, null]], sub: [tn.city, tn.country].filter(Boolean).join(', ') + ' · ' + t('registered {date}', { date: fmtDate(tn.createdAt) }) }) %>

<div class="row g-3 mb-3">
  <div class="col-lg-4"><div class="card h-100"><div class="card-header"><%= t('School') %></div><div class="card-body">
    <dl class="dl-grid mb-0">
      <div><dt><%= t('Account') %></dt><dd><%- statusBadge(tn.status) %></dd></div>
      <div><dt><%= t('Access now') %></dt><dd><%= titleCase(access.mode) %></dd></div>
      <div><dt><%= t('Workspace') %></dt><dd class="font-monospace small"><%= tn.slug %></dd></div>
      <div><dt><%= t('Email') %></dt><dd><%= tn.email %></dd></div>
      <div><dt><%= t('Phone') %></dt><dd><%= tn.phone %></dd></div>
      <div><dt><%= t('Address') %></dt><dd><%= tn.address || '—' %></dd></div>
    </dl>
    <% if (tn.statusReason) { %><div class="alert alert-warning small mt-3 mb-0"><%= tn.statusReason %></div><% } %>
    <div class="small-caps mt-3 mb-1"><%= t('Administrators') %></div>
    <% admins.forEach(function (a) { %><div class="small"><%= a.name %> · <%= a.email %> <span class="text-muted">· <%= t('last login {date}', { date: a.lastLoginAt ? fmtDate(a.lastLoginAt) : t('never') }) %></span></div><% }) %>
  </div></div></div>

  <div class="col-lg-4"><div class="card h-100"><div class="card-header"><%= t('Usage') %> <span class="small text-muted fw-normal"><%= t('(totals only)') %></span></div><div class="card-body">
    <% [['students', usage.students, limits.students], ['teachers', usage.teachers, limits.teachers], ['classes', usage.classes, limits.classes], ['users', usage.users, limits.users]].forEach(function (u) { var pct = u[2] ? Math.min(100, Math.round(u[1] / u[2] * 100)) : 0; %>
      <div class="mb-3"><div class="d-flex justify-content-between small mb-1"><span class="fw-semibold"><%= titleCase(u[0]) %></span><span><%= u[1] %> / <%= u[2] || '∞' %></span></div><div class="progress"><div class="progress-bar" style="width:<%= u[2] ? pct : 4 %>%"></div></div></div>
    <% }) %>
    <div class="small text-muted"><%= t('{students} active students · {payments} fee payments · {expenses} expenses recorded', { students: usage.activeStudents, payments: usage.paymentsRecorded, expenses: usage.expensesRecorded }) %></div>
  </div></div></div>

  <div class="col-lg-4"><div class="card h-100"><div class="card-header"><%= t('Current subscription') %></div><div class="card-body">
    <% if (sub) { %>
      <div class="d-flex justify-content-between"><div class="fs-5 fw-bold"><%= sub.planSnapshot.name %></div><%- statusBadge(sub.status) %></div>
      <div class="small text-muted mb-2"><%= money(sub.planSnapshot.price, sub.planSnapshot.currency) %> / <%= C.BILLING_CYCLES[sub.planSnapshot.billingCycle] ? t(C.BILLING_CYCLES[sub.planSnapshot.billingCycle].label).toLowerCase() : sub.planSnapshot.billingCycle.replace('_', ' ') %></div>
      <dl class="dl-grid mb-3"><div><dt><%= t('Start') %></dt><dd><%= fmtDate(sub.startDate) %></dd></div><div><dt><%= t('End') %></dt><dd><%= fmtDate(sub.endDate) %></dd></div><div><dt><%= t('Grace until') %></dt><dd><%= fmtDate(sub.graceEndDate) %></dd></div></dl>
    <% } else { %><p class="text-muted"><%= t('No subscription.') %></p><% } %>
    <% if (can('subscriptions.manage') && sub) { %>
      <form method="post" action="/platform/schools/<%= tn._id %>/subscription/extend" class="d-flex gap-2 mb-2" data-confirm="<%= t('Extend this subscription?') %>" data-confirm-variant="btn-primary">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="number" class="form-control form-control-sm" name="days" min="1" max="365" value="7" style="max-width:90px"><button class="btn btn-sm btn-light" type="submit"><%= t('Extend days') %></button></form>
      <div class="d-flex flex-wrap gap-2">
        <% if (sub.status !== 'suspended') { %><form method="post" action="/platform/schools/<%= tn._id %>/subscription/suspend" data-confirm="<%= t("Suspend this school's subscription? The school will lose access until reactivated.") %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-danger" type="submit"><%= t('Suspend subscription') %></button></form><% } %>
        <% if (['suspended', 'cancelled'].indexOf(sub.status) >= 0) { %><form method="post" action="/platform/schools/<%= tn._id %>/subscription/reactivate" data-confirm="<%= t('Reactivate this subscription?') %>" data-confirm-variant="btn-primary"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-primary" type="submit"><%= t('Reactivate subscription') %></button></form><% } %>
        <% if (sub.status !== 'cancelled') { %><form method="post" action="/platform/schools/<%= tn._id %>/subscription/cancel" data-confirm="<%= t('Cancel this subscription? School data is kept.') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-light text-danger" type="submit"><%= t('Cancel') %></button></form><% } %>
      </div>
    <% } %>
  </div></div></div>
</div>

<div class="row g-3">
  <div class="col-lg-8">
    <div class="card mb-3"><div class="card-header"><%= t('Subscription payments') %></div><div class="table-responsive"><table class="table table-hover">
      <thead><tr><th><%= t('Reference') %></th><th><%= t('Plan') %></th><th><%= t('Date') %></th><th><%= t('Method') %></th><th class="num"><%= t('Amount') %></th><th><%= t('Status') %></th></tr></thead>
      <tbody>
        <% if (!payments.length) { %><tr><td colspan="6" class="empty-state"><%= t('No payments') %></td></tr><% } %>
        <% payments.forEach(function (p) { %><tr><td><a class="font-monospace small" href="/platform/payments/<%= p._id %>"><%= p.reference %></a></td><td><%= p.plan ? p.plan.name : '' %> × <%= p.periods %></td><td><%= fmtDate(p.createdAt) %></td><td><%= titleCase(p.method) %></td><td class="num"><%= money(p.amount, p.currency) %></td><td><%- statusBadge(p.status) %></td></tr><% }) %>
      </tbody>
    </table></div></div>
    <div class="card"><div class="card-header"><%= t('Subscription history') %></div><div class="table-responsive"><table class="table">
      <thead><tr><th><%= t('Plan') %></th><th><%= t('Start') %></th><th><%= t('End') %></th><th><%= t('Status') %></th><th><%= t('Notes') %></th></tr></thead>
      <tbody><% history.forEach(function (h) { %><tr><td><%= h.planSnapshot ? h.planSnapshot.name : '' %></td><td><%= fmtDate(h.startDate) %></td><td><%= fmtDate(h.endDate) %></td><td><%- statusBadge(h.status) %></td><td class="small text-muted"><%= h.notes %></td></tr><% }) %></tbody>
    </table></div></div>
  </div>
  <div class="col-lg-4">
    <% if (can('schools.status')) { %>
    <div class="card mb-3"><div class="card-header"><%= t('School account status') %></div><div class="card-body d-grid gap-2">
      <% if (tn.status !== 'active') { %>
        <form method="post" action="/platform/schools/<%= tn._id %>/status/reactivate" data-confirm="<%= t('Reactivate {name}?', { name: tn.name }) %>" data-confirm-variant="btn-primary"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-primary w-100" type="submit"><%= t('Activate / reactivate') %></button></form>
      <% } else { %>
        <form method="post" action="/platform/schools/<%= tn._id %>/status/suspend" data-confirm="<%= t('Suspend {name}? All its users lose access; data is kept.', { name: tn.name }) %>" data-confirm-reason="true" data-confirm-button="<%= t('Suspend school') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-danger w-100" type="submit"><%= t('Suspend school') %></button></form>
        <form method="post" action="/platform/schools/<%= tn._id %>/status/deactivate" data-confirm="<%= t('Deactivate {name}?', { name: tn.name }) %>" data-confirm-reason="true" data-confirm-button="<%= t('Deactivate') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-light w-100" type="submit"><%= t('Deactivate') %></button></form>
      <% } %>
    </div></div>
    <% } %>
    <% if (can('payments.verify')) { %>
    <div class="card"><div class="card-header"><%= t('Record a payment received') %></div><div class="card-body">
      <form method="post" action="/platform/schools/<%= tn._id %>/payments" class="row g-2">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <%- include('../partials/field', { name: 'planId', label: 'Plan', ftype: 'select', required: true, value: sub ? sub.plan && sub.plan._id : '', options: plans.filter(function (p) { return p.isActive; }).map(function (p) { return { value: p._id, label: p.name + ' (' + money(p.price, p.currency) + ')' }; }) }) %>
        <%- include('../partials/field', { name: 'periods', label: 'Periods', ftype: 'number', value: 1, min: 1, max: 24, col: 'col-4', required: true }) %>
        <%- include('../partials/field', { name: 'method', label: 'Method', ftype: 'select', col: 'col-8', required: true, options: C.PLATFORM_PAYMENT_METHODS.map(function (m) { return { value: m, label: titleCase(m) }; }) }) %>
        <%- include('../partials/field', { name: 'transactionRef', label: 'Transaction ref.', required: true, col: 'col-7' }) %>
        <%- include('../partials/field', { name: 'paidAt', label: 'Paid on', ftype: 'date', value: isoDate(new Date()), required: true, col: 'col-5' }) %>
        <div class="col-12"><button class="btn btn-primary w-100" type="submit"><%= t('Record as pending') %></button></div>
      </form>
    </div></div>
    <% } %>
  </div>
</div>
