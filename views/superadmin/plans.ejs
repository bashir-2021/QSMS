<%- include('../partials/page-header', { heading: 'Plans & pricing', sub: 'Changes apply to new subscriptions and renewals; current subscriptions keep their purchased terms.',
  actions: can('plans.manage') ? '<a class="btn btn-primary btn-icon" href="/platform/plans/new"><i class="bi bi-plus-lg"></i>' + t('New plan') + '</a>' : '' }) %>
<div class="card">
  <div class="table-responsive"><table class="table table-hover">
    <thead><tr><th><%= t('Plan') %></th><th class="num"><%= t('Price') %></th><th><%= t('Cycle') %></th><th><%= t('Limits (students / teachers / classes / users)') %></th><th><%= t('Trial · grace') %></th><th><%= t('Modules') %></th><th><%= t('Visibility') %></th><th></th></tr></thead>
    <tbody>
      <% if (!plans.length) { %><tr><td colspan="8" class="empty-state"><%= t('No plans yet') %></td></tr><% } %>
      <% plans.forEach(function (p) { var lim = function (v) { return v || '∞'; }; %>
        <tr><td><div class="fw-semibold"><%= p.name %></div><div class="small text-muted font-monospace"><%= p.code %></div></td>
          <td class="num fw-semibold"><%= money(p.price, p.currency) %></td>
          <td><%= p.billingCycle === 'custom' ? t('{n} days', { n: p.customDays }) : t(C.BILLING_CYCLES[p.billingCycle].label) %></td>
          <td class="small"><%= lim(p.limits.students) %> / <%= lim(p.limits.teachers) %> / <%= lim(p.limits.classes) %> / <%= lim(p.limits.users) %></td>
          <td class="small"><%= t('{n}d', { n: p.trialDays }) %> · <%= t('{n}d', { n: p.graceDays }) %></td>
          <td class="small"><%= t('{n} of {total}', { n: p.features.length, total: Object.keys(C.PLAN_FEATURES).length }) %></td>
          <td><%- statusBadge(p.isActive ? 'active' : 'inactive') %> <% if (!p.isPublic) { %><span class="badge badge-soft-secondary"><%= t('Hidden') %></span><% } %></td>
          <td class="text-end"><% if (can('plans.manage')) { %><a class="btn btn-sm btn-light" href="/platform/plans/<%= p._id %>/edit"><%= t('Edit') %></a><% } %></td></tr>
      <% }) %>
    </tbody>
  </table></div>
</div>
