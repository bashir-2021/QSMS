<%- include('../partials/page-header', { heading: t('Payment {ref}', { ref: p.reference }), crumbs: [['Payments', '/platform/payments'], [p.reference, null]] }) %>
<div class="row g-3">
  <div class="col-lg-8"><div class="card"><div class="card-body">
    <dl class="dl-grid mb-0">
      <div><dt><%= t('School') %></dt><dd><a href="/platform/schools/<%= p.tenant._id %>"><%= p.tenant.name %></a></dd></div>
      <div><dt><%= t('Plan') %></dt><dd><%= p.plan.name %> × <%= t('{n} period(s)', { n: p.periods }) %></dd></div>
      <div><dt><%= t('Amount') %></dt><dd class="fs-5"><%= money(p.amount, p.currency) %></dd></div>
      <div><dt><%= t('Status') %></dt><dd><%- statusBadge(p.status) %></dd></div>
      <div><dt><%= t('Method') %></dt><dd><%= titleCase(p.method) %></dd></div>
      <div><dt><%= t('Transaction reference') %></dt><dd class="font-monospace"><%= p.transactionRef || '—' %></dd></div>
      <div><dt><%= t('Payer') %></dt><dd><%= p.payerName || '—' %></dd></div>
      <div><dt><%= t('Paid on') %></dt><dd><%= fmtDate(p.paidAt) %></dd></div>
      <div><dt><%= t('Submitted') %></dt><dd><%= fmtDate(p.createdAt) %> <%= t('by') %> <%= p.submittedBy ? p.submittedBy.name + ' (' + t(p.submittedBy.kind) + ')' : '' %></dd></div>
      <% if (p.verifiedAt) { %><div><dt><%= t('Reviewed') %></dt><dd><%= fmtDate(p.verifiedAt) %> <%= t('by') %> <%= p.verifiedBy ? p.verifiedBy.name : '' %></dd></div><% } %>
      <% if (p.periodEnd) { %><div><dt><%= t('Subscription period') %></dt><dd><%= fmtDate(p.periodStart) %> – <%= fmtDate(p.periodEnd) %></dd></div><% } %>
    </dl>
    <% if (p.notes) { %><div class="alert alert-light small mt-3 mb-0"><%= p.notes %></div><% } %>
  </div></div></div>
  <div class="col-lg-4">
    <% if (can('payments.verify')) { %>
      <% if (p.status === 'pending') { %>
        <div class="card"><div class="card-body d-grid gap-2">
          <p class="small text-muted mb-1"><%= t('Confirm the money was received (check the mobile money / bank statement for reference {ref}) before verifying.', { ref: p.transactionRef }) %></p>
          <form method="post" action="/platform/payments/<%= p._id %>/verify" data-confirm="<%= t('Verify {amount} from {school}? This activates/extends their subscription.', { amount: money(p.amount, p.currency), school: p.tenant.name }) %>" data-confirm-variant="btn-success" data-confirm-button="<%= t('Verify payment') %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-success w-100" type="submit"><i class="bi bi-patch-check"></i> <%= t('Verify payment') %></button></form>
          <form method="post" action="/platform/payments/<%= p._id %>/status/failed" data-confirm="<%= t('Mark this payment as failed (money not received)?') %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="notes" value="Payment not found on statement"><button class="btn btn-outline-danger w-100" type="submit"><%= t('Mark failed') %></button></form>
          <form method="post" action="/platform/payments/<%= p._id %>/status/cancelled" data-confirm="<%= t('Cancel this payment request?') %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-light w-100" type="submit"><%= t('Cancel') %></button></form>
        </div></div>
      <% } else if (p.status === 'paid') { %>
        <div class="card"><div class="card-body">
          <form method="post" action="/platform/payments/<%= p._id %>/status/refunded" data-confirm="<%= t('Mark this payment as refunded? The subscription period is not changed automatically — suspend or cancel it separately if needed.') %>" data-confirm-button="<%= t('Mark refunded') %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label"><%= t('Refund note') %></label><input class="form-control mb-2" name="notes" maxlength="200"><button class="btn btn-outline-secondary w-100" type="submit"><%= t('Mark refunded') %></button></form>
        </div></div>
      <% } %>
    <% } %>
  </div>
</div>
