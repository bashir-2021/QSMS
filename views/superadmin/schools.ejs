<%- include('../partials/page-header', { heading: 'Schools', sub: page.total + ' registered schools', actions: can('schools.manage') ? '<a class="btn btn-primary btn-icon" href="/platform/schools/new"><i class="bi bi-plus-lg"></i>Register school</a>' : '' }) %>

<form class="filter-bar row g-2 align-items-end" method="get">
  <div class="col-md-5"><label class="form-label">Search</label><input class="form-control" name="search" value="<%= query.search || '' %>" placeholder="Name, city, country, email"></div>
  <div class="col-6 col-md-2"><label class="form-label">Account</label><select class="form-select" name="status" data-autosubmit><option value="">All</option><% C.TENANT_STATUSES.forEach(function (s) { %><option value="<%= s %>" <%= selected(query.status, s) %>><%= titleCase(s) %></option><% }) %></select></div>
  <div class="col-6 col-md-3"><label class="form-label">Subscription</label><select class="form-select" name="subscription" data-autosubmit><option value="">All</option><% C.SUBSCRIPTION_STATUSES.forEach(function (s) { %><option value="<%= s %>" <%= selected(query.subscription, s) %>><%= titleCase(s) %></option><% }) %></select></div>
  <div class="col-md-2"><button class="btn btn-primary w-100" type="submit"><i class="bi bi-search"></i> Search</button></div>
</form>

<div class="card">
  <div class="table-responsive"><table class="table table-hover">
    <thead><tr><th>School</th><th>Location</th><th>Plan</th><th>Subscription</th><th>Ends</th><th class="num">Students</th><th class="num">Users</th><th>Account</th></tr></thead>
    <tbody>
      <% if (!page.items.length) { %><tr><td colspan="8"><div class="empty-state"><i class="bi bi-buildings"></i>No schools found.</div></td></tr><% } %>
      <% page.items.forEach(function (t) { var s = t.currentSubscription; %>
        <tr><td><a class="row-link" href="/platform/schools/<%= t._id %>"><%= t.name %></a><div class="small text-muted"><%= t.email %></div></td>
          <td><%= [t.city, t.country].filter(Boolean).join(', ') %></td><td><%= s && s.planSnapshot ? s.planSnapshot.name : '—' %></td>
          <td><%- s ? statusBadge(s.status) : '—' %></td><td><%= s ? fmtDate(s.endDate) : '' %></td>
          <td class="num"><%= t.studentCount %></td><td class="num"><%= t.userCount %></td><td><%- statusBadge(t.status) %></td></tr>
      <% }) %>
    </tbody>
  </table></div>
  <%- include('../partials/pagination', { page: page }) %>
</div>
