<%- include('../partials/page-header', { heading: 'Platform reports', sub: 'Financial and operational reports for the Quranic platform. Exports to PDF and Excel.' }) %>
<% var icons = { revenue: 'cash-stack', subscriptions: 'arrow-repeat', usage: 'bar-chart', pending: 'hourglass-split' }; %>
<div class="row g-3">
  <% Object.keys(reports).forEach(function (k) { %>
    <div class="col-md-6"><a class="card h-100 text-decoration-none text-reset" href="/platform/reports/<%= k %>"><div class="card-body d-flex gap-3 align-items-center">
      <div class="stat-icon emerald"><i class="bi bi-<%= icons[k] %>"></i></div><div><div class="fw-bold" style="color:var(--q-ink)"><%= t(reports[k]) %></div><div class="small text-muted"><%= t('View, print, PDF & Excel') %></div></div><i class="bi bi-chevron-right ms-auto text-muted"></i>
    </div></a></div>
  <% }) %>
</div>
