<% var tx = function (v) { return typeof v === 'string' ? t(v) : v; }; %>
<% report.sections.forEach(function (sec) { var right = function (c) { return ['money', 'number', 'percent'].indexOf(c.type) >= 0; }; %>
<div class="card mb-3">
  <div class="card-header d-flex justify-content-between"><span><%= t(sec.title) %></span><span class="small text-muted"><%= sec.rows.length === 1 ? t('1 row') : t('{n} rows', { n: sec.rows.length }) %></span></div>
  <div class="table-responsive"><table class="table table-hover table-sm">
    <thead><tr><% sec.columns.forEach(function (c) { %><th class="<%= right(c) ? 'num' : '' %>"><%= t(c.label) %></th><% }) %></tr></thead>
    <tbody>
      <% if (!sec.rows.length) { %><tr><td colspan="<%= sec.columns.length %>" class="empty-state"><%= t('No records for this selection') %></td></tr><% } %>
      <% sec.rows.forEach(function (r) { %><tr><% sec.columns.forEach(function (c) { %><td class="<%= right(c) ? 'num' : '' %>"><%- reportCell(!c.type || c.type === 'text' ? tx(r[c.key]) : r[c.key], c.type, currencyCode) %></td><% }) %></tr><% }) %>
    </tbody>
    <% if (sec.totals && sec.rows.length) { %>
      <tfoot><tr><% sec.columns.forEach(function (c) { var tv = sec.totals[c.key]; var lbl = typeof tv === 'string' && c.type !== 'money'; %><td class="<%= right(c) ? 'num' : '' %>"><%- reportCell(lbl ? tx(tv) : tv, lbl ? 'text' : c.type, currencyCode) %></td><% }) %></tr></tfoot>
    <% } %>
  </table></div>
</div>
<% }) %>
