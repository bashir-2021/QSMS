<div class="row g-3 justify-content-center">
  <% if (!plans.length) { %><div class="col-12"><div class="empty-state"><%= t('Plans will be published soon.') %></div></div><% } %>
  <% var perCycle = { monthly: 'month', quarterly: 'quarter', six_months: '6 months', annual: 'year' }; %>
  <% plans.forEach(function (p, i) { var featured = plans.length > 2 && i === 1; %>
    <div class="col-md-6 col-xl-3">
      <div class="plan-card <%= featured ? 'featured' : '' %>">
        <div class="d-flex justify-content-between align-items-center">
          <h3 class="h5 mb-0"><%= p.name %></h3>
          <% if (featured) { %><span class="badge badge-soft-primary"><%= t('Most popular') %></span><% } %>
        </div>
        <p class="text-muted small mt-2 mb-3"><%= p.description %></p>
        <div><span class="price"><%= money(p.price, p.currency) %></span>
          <span class="text-muted">/ <%= p.billingCycle === 'custom' ? t('{n} days', { n: p.customDays }) : (perCycle[p.billingCycle] ? t(perCycle[p.billingCycle]) : t(C.BILLING_CYCLES[p.billingCycle].label).toLowerCase()) %></span></div>
        <% if (p.trialDays) { %><div class="small text-success fw-semibold mt-1"><%= t('{n}-day free trial', { n: p.trialDays }) %></div><% } %>
        <ul class="small">
          <li><i class="bi bi-people"></i><%= p.limits.students ? t('Up to {n} students', { n: p.limits.students }) : t('Unlimited students') %></li>
          <li><i class="bi bi-person-badge"></i><%= p.limits.teachers ? t('Up to {n} teachers', { n: p.limits.teachers }) : t('Unlimited teachers') %></li>
          <li><i class="bi bi-easel"></i><%= p.limits.classes ? t('Up to {n} classes', { n: p.limits.classes }) : t('Unlimited classes') %></li>
          <li><i class="bi bi-shield-lock"></i><%= p.limits.users ? t('{n} user accounts', { n: p.limits.users }) : t('Unlimited users') %></li>
          <% p.features.forEach(function (f) { %><li><i class="bi bi-check2"></i><%= t(C.PLAN_FEATURES[f]) %></li><% }) %>
        </ul>
        <a class="btn <%= featured ? 'btn-primary' : 'btn-outline-primary' %> w-100" href="/register?plan=<%= p._id %>"><%= t('Choose {name}', { name: p.name }) %></a>
      </div>
    </div>
  <% }) %>
</div>
