<%- include('../partials/page-header', { heading: 'Invoices & billing', sub: 'Invoices are amounts owed — only confirmed payments count as income.',
  actions: can('invoices.manage') ? '<a class="btn btn-light btn-icon" href="/school/finance/invoices/new"><i class="bi bi-plus-lg"></i>' + t('New invoice') + '</a>' : '' }) %>

<% if (can('invoices.manage')) { %>
<div class="card mb-3"><div class="card-body">
  <form method="post" action="/school/finance/invoices/generate" class="row g-2 align-items-end" data-confirm="<%= t('Generate monthly bills for all active students in the selected scope? Students already billed for that month are skipped automatically.') %>" data-confirm-variant="btn-primary" data-confirm-button="<%= t('Generate bills') %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="col-12 col-md-3"><div class="fw-bold" style="color:var(--q-ink)"><i class="bi bi-lightning-charge text-warning"></i> <%= t('Monthly billing') %></div><div class="small text-muted"><%= t('Uses student, class or school fee') %></div></div>
    <div class="col-6 col-md-3"><label class="form-label"><%= t('Billing month') %></label><input type="month" class="form-control" name="period" value="<%= thisPeriod %>" required></div>
    <div class="col-6 col-md-3"><label class="form-label"><%= t('Class') %></label><select class="form-select" name="class"><option value=""><%= t('All active students') %></option><% classes.forEach(function (c) { %><option value="<%= c._id %>"><%= c.name %></option><% }) %></select></div>
    <div class="col-md-3"><button class="btn btn-primary w-100" type="submit"><%= t('Generate bills') %></button></div>
  </form>
</div></div>
<% } %>

<form class="filter-bar row g-2 align-items-end" method="get">
  <div class="col-md-3"><label class="form-label"><%= t('Search') %></label><input class="form-control" name="search" value="<%= query.search || '' %>" placeholder="<%= t('Student, ID or invoice #') %>"></div>
  <div class="col-6 col-md-2"><label class="form-label"><%= t('Status') %></label><select class="form-select" name="status" data-autosubmit><option value=""><%= t('All') %></option><option value="open" <%= selected(query.status, 'open') %>><%= t('Open (unpaid/partial/overdue)') %></option><% C.INVOICE_STATUSES.forEach(function (s) { %><option value="<%= s %>" <%= selected(query.status, s) %>><%= titleCase(s) %></option><% }) %></select></div>
  <div class="col-6 col-md-2"><label class="form-label"><%= t('Type') %></label><select class="form-select" name="type" data-autosubmit><option value=""><%= t('All') %></option><% Object.keys(C.INVOICE_TYPES).forEach(function (it) { %><option value="<%= it %>" <%= selected(query.type, it) %>><%= t(C.INVOICE_TYPES[it]) %></option><% }) %></select></div>
  <div class="col-6 col-md-2"><label class="form-label"><%= t('Month') %></label><input type="month" class="form-control" name="period" value="<%= query.period || '' %>"></div>
  <div class="col-6 col-md-2"><label class="form-label"><%= t('Class') %></label><select class="form-select" name="class" data-autosubmit><option value=""><%= t('All') %></option><% classes.forEach(function (c) { %><option value="<%= c._id %>" <%= selected(query.class, c._id) %>><%= c.name %></option><% }) %></select></div>
  <div class="col-md-1"><button class="btn btn-primary w-100" type="submit" title="<%= t('Search') %>" aria-label="<%= t('Search') %>"><i class="bi bi-search"></i></button></div>
</form>

<div class="card">
  <div class="table-responsive"><table class="table table-hover">
    <thead><tr><th><%= t('Invoice') %></th><th><%= t('Student') %></th><th><%= t('Description') %></th><th><%= t('Due') %></th><th class="num"><%= t('Total') %></th><th class="num"><%= t('Paid') %></th><th class="num"><%= t('Balance') %></th><th><%= t('Status') %></th><th></th></tr></thead>
    <tbody>
      <% if (!page.items.length) { %><tr><td colspan="9"><div class="empty-state"><i class="bi bi-receipt"></i><%= t('No invoices match.') %></div></td></tr><% } %>
      <% page.items.forEach(function (i) { %>
        <tr>
          <td><a class="row-link font-monospace small" href="/school/finance/invoices/<%= i._id %>"><%= i.invoiceNo %></a></td>
          <td><% if (i.student) { %><a class="row-link" href="/school/students/<%= i.student._id %>"><%= i.student.fullName %></a><div class="small text-muted"><%= i.student.studentCode %><%= i.class ? ' · ' + i.class.name : '' %></div><% } %></td>
          <td class="small"><%= t(i.description) %></td><td class="text-nowrap"><%= fmtDate(i.dueDate) %></td>
          <td class="num"><%= money(i.total, currency) %></td><td class="num"><%= money(i.paid, currency) %></td>
          <td class="num fw-semibold"><%= i.status === 'cancelled' ? '—' : money(i.total - i.paid, currency) %></td><td><%- statusBadge(i.status) %></td>
          <td class="text-end"><% if (can('payments.create') && ['unpaid', 'partial', 'overdue'].indexOf(i.status) >= 0 && i.student) { %><a class="btn btn-sm btn-outline-primary" href="/school/finance/payments/new?student=<%= i.student._id %>&invoice=<%= i._id %>"><%= t('Pay') %></a><% } %></td>
        </tr>
      <% }) %>
    </tbody>
  </table></div>
  <%- include('../partials/pagination', { page: page }) %>
</div>
