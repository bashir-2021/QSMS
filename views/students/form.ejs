<% var s = student || {}; var editing = Boolean(student); %>
<%- include('../partials/page-header', { heading: editing ? 'Edit student' : 'Register student', crumbs: [['Students', '/school/students'], [editing ? s.fullName : 'New', null]] }) %>

<form method="post" action="<%= editing ? '/school/students/' + s._id : '/school/students' %>?_csrf=<%= csrfToken %>" enctype="multipart/form-data" class="needs-validation" novalidate>
  <div class="row g-3">
    <div class="col-lg-8">
      <div class="card mb-3"><div class="card-header">Student details</div><div class="card-body row g-3">
        <%- include('../partials/field', { name: 'fullName', label: 'Full name', value: s.fullName, required: true, col: 'col-md-8' }) %>
        <%- include('../partials/field', { name: 'gender', label: 'Gender', ftype: 'select', value: s.gender, required: true, col: 'col-md-4', options: C.GENDERS.map(function (g) { return { value: g, label: titleCase(g) }; }) }) %>
        <%- include('../partials/field', { name: 'dateOfBirth', label: 'Date of birth', ftype: 'date', value: isoDate(s.dateOfBirth), col: 'col-md-4' }) %>
        <%- include('../partials/field', { name: 'registrationDate', label: 'Registration date', ftype: 'date', value: isoDate(s.registrationDate || new Date()), col: 'col-md-4' }) %>
        <%- include('../partials/field', { name: 'status', label: 'Status', ftype: 'select', value: s.status || 'active', col: 'col-md-4', placeholder: false, options: C.STUDENT_STATUSES.map(function (x) { return { value: x, label: titleCase(x) }; }) }) %>
        <%- include('../partials/field', { name: 'address', label: 'Address', value: s.address }) %>
      </div></div>

      <div class="card mb-3"><div class="card-header">Guardian</div><div class="card-body row g-3">
        <%- include('../partials/field', { name: 'guardianName', label: 'Guardian name', value: s.guardianName, col: 'col-md-5' }) %>
        <%- include('../partials/field', { name: 'guardianRelation', label: 'Relationship', value: s.guardianRelation, col: 'col-md-3', placeholder: 'Father, Mother…' }) %>
        <%- include('../partials/field', { name: 'guardianPhone', label: 'Guardian phone', ftype: 'tel', value: s.guardianPhone, col: 'col-md-4' }) %>
      </div></div>

      <div class="card mb-3"><div class="card-header">Class placement &amp; fees</div><div class="card-body row g-3">
        <%- include('../partials/field', { name: 'class', label: 'Class', ftype: 'select', value: s.class, col: 'col-md-6', placeholder: '— Not assigned —', options: classes.map(function (c) { return { value: c._id, label: c.name + ' (' + c.level + ')' }; }), help: editing ? 'Changing the class records a transfer in the enrolment history.' : '' }) %>
        <%- include('../partials/field', { name: 'teacher', label: 'Teacher', ftype: 'select', value: s.teacher, col: 'col-md-6', placeholder: '— Class teacher —', options: teachers.map(function (t) { return { value: t._id, label: t.fullName }; }) }) %>
        <%- include('../partials/field', { name: 'feeOverride', label: 'Custom monthly fee (optional)', ftype: 'money', value: s.feeOverride != null ? moneyInput(s.feeOverride) : '', col: 'col-md-6', help: 'Leave empty to use the class fee or the school fee (' + money(settings.monthlyFee, currency) + ').' }) %>
        <% if (!editing && settings.registrationFee > 0 && can('invoices.manage')) { %>
          <div class="col-md-6 d-flex align-items-end"><div class="form-check form-switch mb-2">
            <input class="form-check-input" type="checkbox" name="chargeRegistration" id="chargeRegistration" checked>
            <label class="form-check-label" for="chargeRegistration">Create registration fee invoice (<%= money(settings.registrationFee, currency) %>)</label>
          </div></div>
        <% } %>
        <%- include('../partials/field', { name: 'notes', label: 'Notes', ftype: 'textarea', value: s.notes, rows: 2, max: 500 }) %>
      </div></div>
    </div>
    <div class="col-lg-4">
      <div class="card mb-3"><div class="card-header">Photo</div><div class="card-body text-center">
        <img id="photoPreview" class="rounded-4 mb-3 <%= s.photo ? '' : 'd-none' %>" style="width:140px;height:140px;object-fit:cover" src="<%= s.photo ? '/school/files/' + s.photo.split('/').pop() : '' %>" alt="">
        <input type="file" class="form-control" name="photo" accept="image/png,image/jpeg,image/webp" data-preview="#photoPreview">
        <div class="form-text">JPG, PNG or WebP · max 2 MB</div>
      </div></div>
      <div class="card"><div class="card-body d-grid gap-2">
        <button class="btn btn-primary" type="submit"><%= editing ? 'Save changes' : 'Register student' %></button>
        <a class="btn btn-light" href="<%= editing ? '/school/students/' + s._id : '/school/students' %>">Cancel</a>
      </div></div>
    </div>
  </div>
</form>
