<% var sub = subscription; var snap = sub ? sub.planSnapshot : null; %>
<%- include('../partials/page-header', { heading: 'Subscription', sub: 'Your Quranic plan, usage limits and renewal payments.' }) %>

<div class="row g-3 mb-3">
  <div class="col-lg-5"><div class="card h-100"><div class="card-body">
    <div class="d-flex justify-content-between align-items-start">
      <div><div class="small-caps"><%= t('Current plan') %></div><div class="fs-3 fw-bold" style="color:var(--q-ink)"><%= snap ? snap.name : t('None') %></div>
        <% if (snap) { %><div class="text-muted"><%= money(snap.price, snap.currency) %> / <%= C.BILLING_CYCLES[snap.billingCycle] ? t(C.BILLING_CYCLES[snap.billingCycle].label).toLowerCase() : '' %></div><% } %></div>
      <%- statusBadge(access.status) %>
    </div>
    <% if (sub) { %>
      <dl class="dl-grid mt-3 mb-0">
        <div><dt><%= t('Started') %></dt><dd><%= fmtDate(sub.startDate) %></dd></div>
        <div><dt><%= t('Ends') %></dt><dd><%= fmtDate(sub.endDate) %></dd></div>
        <div><dt><%= t('Grace period until') %></dt><dd><%= fmtDate(sub.graceEndDate) || '—' %></dd></div>
        <div><dt><%= t('Access') %></dt><dd><%= titleCase(access.mode) %></dd></div>
      </dl>
      <div class="mt-3"><div class="small-caps mb-1"><%= t('Included modules') %></div>
        <div class="d-flex flex-wrap gap-1"><% Object.keys(C.PLAN_FEATURES).forEach(function (f) { var on = snap.features.indexOf(f) >= 0; %><span class="badge <%= on ? 'badge-soft-success' : 'badge-soft-secondary text-decoration-line-through' %>"><%= t(C.PLAN_FEATURES[f]) %></span><% }) %></div></div>
    <% } %>
  </div></div></div>
  <div class="col-lg-7"><div class="card h-100"><div class="card-header"><%= t('Usage') %></div><div class="card-body">
    <% ['students', 'teachers', 'classes', 'users'].forEach(function (k) { var u = usage[k]; var pct = u.max ? Math.min(100, Math.round(u.used / u.max * 100)) : 0; %>
      <div class="mb-3"><div class="d-flex justify-content-between small mb-1"><span class="fw-semibold"><%= titleCase(k) %></span><span><%= u.used %> / <%= u.max || '∞' %></span></div>
        <div class="progress"><div class="progress-bar <%= pct >= 90 ? 'bg-danger' : pct >= 75 ? 'bg-warning' : '' %>" style="width:<%= u.max ? pct : 4 %>%"></div></div></div>
    <% }) %>
  </div></div></div>
</div>

<div class="row g-3">
  <% if (can('subscription.manage')) { %>
  <div class="col-lg-5"><div class="card"><div class="card-header"><%= t('Renew or change plan') %></div><div class="card-body">
    <p class="small text-muted"><%= t('Pay with mobile money or bank transfer, then submit the details here. Your subscription is activated or extended as soon as Quranic verifies the payment.') %></p>
    <form method="post" action="/school/subscription/payments" class="row g-3 needs-validation" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <%- include('../partials/field', { name: 'planId', label: 'Plan', ftype: 'select', required: true, value: sub ? sub.plan : '', options: plans.map(function (p) { return { value: p._id, label: p.name + ' — ' + money(p.price, p.currency) + ' / ' + t(C.BILLING_CYCLES[p.billingCycle].label).toLowerCase() }; }) }) %>
      <%- include('../partials/field', { name: 'periods', label: 'Number of periods', ftype: 'number', value: 1, min: 1, max: 24, required: true, col: 'col-md-4' }) %>
      <%- include('../partials/field', { name: 'method', label: 'Method', ftype: 'select', required: true, col: 'col-md-8', options: methods.map(function (m) { return { value: m, label: titleCase(m) }; }) }) %>
      <%- include('../partials/field', { name: 'transactionRef', label: 'Transaction reference', required: true, col: 'col-md-7' }) %>
      <%- include('../partials/field', { name: 'paidAt', label: 'Paid on', ftype: 'date', value: isoDate(new Date()), required: true, col: 'col-md-5' }) %>
      <%- include('../partials/field', { name: 'payerName', label: 'Payer name' }) %>
      <div class="col-12"><button class="btn btn-primary w-100" type="submit"><%= t('Submit payment for verification') %></button></div>
    </form>
  </div></div></div>
  <% } %>
  <div class="col-lg-<%= can('subscription.manage') ? '7' : '12' %>"><div class="card"><div class="card-header"><%= t('Subscription payments') %></div>
    <div class="table-responsive"><table class="table">
      <thead><tr><th><%= t('Reference') %></th><th><%= t('Plan') %></th><th><%= t('Submitted') %></th><th><%= t('Method') %></th><th class="num"><%= t('Amount') %></th><th><%= t('Status') %></th></tr></thead>
      <tbody>
        <% if (!payments.length) { %><tr><td colspan="6" class="empty-state"><%= t('No payments yet') %></td></tr><% } %>
        <% payments.forEach(function (p) { %>
          <tr><td class="font-monospace small"><%= p.reference %><div class="text-muted"><%= p.transactionRef %></div></td><td><%= p.plan ? p.plan.name : '' %> × <%= p.periods %></td><td><%= fmtDate(p.createdAt) %></td><td><%= titleCase(p.method) %></td><td class="num"><%= money(p.amount, p.currency) %></td><td><%- statusBadge(p.status) %><% if (p.periodEnd) { %><div class="small text-muted"><%= t('until {date}', { date: fmtDate(p.periodEnd) }) %></div><% } %></td></tr>
        <% }) %>
      </tbody>
    </table></div>
  </div></div>
</div>
