<%- include('../partials/page-header', { heading: C.ACTIVITY_TYPES[type], sub: type === 'subac' ? 'Subac sessions — recitation and review with participant evaluation' : 'Duruus — lessons and lectures with attendance and evaluation',
  actions: can('activities.manage') ? '<a class="btn btn-primary btn-icon" href="/school/activities/' + type + '/new"><i class="bi bi-plus-lg"></i>New session</a>' : '' }) %>

<form class="filter-bar row g-2 align-items-end" method="get">
  <div class="col-md-4"><label class="form-label">Search</label><input class="form-control" name="search" value="<%= query.search || '' %>" placeholder="Title or topic"></div>
  <div class="col-6 col-md-3"><label class="form-label">Class</label><select class="form-select" name="class" data-autosubmit><option value="">All</option><% classes.forEach(function (c) { %><option value="<%= c._id %>" <%= selected(query.class, c._id) %>><%= c.name %></option><% }) %></select></div>
  <div class="col-6 col-md-2"><label class="form-label">From</label><input type="date" class="form-control" name="from" value="<%= query.from || '' %>"></div>
  <div class="col-6 col-md-2"><label class="form-label">To</label><input type="date" class="form-control" name="to" value="<%= query.to || '' %>"></div>
  <div class="col-6 col-md-1"><button class="btn btn-primary w-100" type="submit"><i class="bi bi-search"></i></button></div>
</form>

<div class="card">
  <div class="table-responsive"><table class="table table-hover">
    <thead><tr><th>Date</th><th>Title</th><th>Topic</th><th>Class</th><th>Teacher</th><th class="num">Participants</th></tr></thead>
    <tbody>
      <% if (!page.items.length) { %><tr><td colspan="6"><div class="empty-state"><i class="bi bi-journal"></i>No sessions recorded.</div></td></tr><% } %>
      <% page.items.forEach(function (a) { %>
        <tr><td class="text-nowrap"><%= fmtDate(a.date) %></td><td><a class="row-link" href="/school/activities/<%= type %>/<%= a._id %>"><%= a.title %></a></td><td class="small"><%= a.topic || '—' %></td>
          <td><%= a.class ? a.class.name : '' %></td><td><%= a.teacher ? a.teacher.fullName : '' %></td><td class="num"><%= a.participants.present %> / <%= a.participants.n %></td></tr>
      <% }) %>
    </tbody>
  </table></div>
  <%- include('../partials/pagination', { page: page }) %>
</div>
