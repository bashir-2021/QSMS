<%- include('../partials/page-header', { heading: t(C.ACTIVITY_TYPES[type]), sub: type === 'subac' ? 'Subac sessions — recitation and review with participant evaluation' : 'Duruus — lessons and lectures with attendance and evaluation',
  actions: can('activities.manage') ? '<a class="btn btn-primary btn-icon" href="/school/activities/' + type + '/new"><i class="bi bi-plus-lg"></i>' + t('New session') + '</a>' : '' }) %>

<form class="filter-bar row g-2 align-items-end" method="get">
  <div class="<%= type === 'subac' ? 'col-md-2' : 'col-md-4' %>"><label class="form-label"><%= t('Search') %></label><input class="form-control" name="search" value="<%= query.search || '' %>" placeholder="<%= t('Title or topic') %>"></div>
  <% if (type === 'subac') { %><div class="col-6 col-md-2"><label class="form-label"><%= t('Frequency') %></label><select class="form-select" name="frequency" data-autosubmit><option value=""><%= t('All') %></option><% C.SUBAC_FREQUENCIES.forEach(function (f) { %><option value="<%= f %>" <%= selected(query.frequency, f) %>><%= titleCase(f) %></option><% }) %></select></div><% } %>
  <div class="col-6 col-md-3"><label class="form-label"><%= t('Class') %></label><select class="form-select" name="class" data-autosubmit><option value=""><%= t('All') %></option><% classes.forEach(function (c) { %><option value="<%= c._id %>" <%= selected(query.class, c._id) %>><%= c.name %></option><% }) %></select></div>
  <div class="col-6 col-md-2"><label class="form-label"><%= t('From') %></label><input type="date" class="form-control" name="from" value="<%= query.from || '' %>"></div>
  <div class="col-6 col-md-2"><label class="form-label"><%= t('To') %></label><input type="date" class="form-control" name="to" value="<%= query.to || '' %>"></div>
  <div class="col-6 col-md-1"><button class="btn btn-primary w-100" type="submit" title="<%= t('Search') %>" aria-label="<%= t('Search') %>"><i class="bi bi-search"></i></button></div>
</form>

<div class="card">
  <div class="table-responsive"><table class="table table-hover">
    <thead><tr><th><%= t('Date') %></th><th><%= t('Title') %></th><% if (type === 'subac') { %><th><%= t('Frequency') %></th><% } %><th><%= t('Topic') %></th><th><%= t('Class') %></th><th><%= t('Teacher') %></th><th class="num"><%= t('Participants') %></th></tr></thead>
    <tbody>
      <% if (!page.items.length) { %><tr><td colspan="7"><div class="empty-state"><i class="bi bi-journal"></i><%= t('No sessions recorded.') %></div></td></tr><% } %>
      <% page.items.forEach(function (a) { %>
        <tr><td class="text-nowrap"><%= fmtDate(a.date) %></td><td><a class="row-link" href="/school/activities/<%= type %>/<%= a._id %>"><%= a.title %></a></td><% if (type === 'subac') { %><td><%- a.frequency ? statusBadge(a.frequency) : '—' %></td><% } %><td class="small"><%= a.topic || '—' %></td>
          <td><%= a.class ? a.class.name : '' %></td><td><%= a.teacher ? a.teacher.fullName : '' %></td><td class="num"><%= a.participants.present %> / <%= a.participants.n %></td></tr>
      <% }) %>
    </tbody>
  </table></div>
  <%- include('../partials/pagination', { page: page }) %>
</div>
