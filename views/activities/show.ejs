<% var a = activity; var base = '/school/activities/' + type; var editable = can('activities.manage'); %>
<%- include('../partials/page-header', { heading: a.title, crumbs: [[t(C.ACTIVITY_TYPES[type]), base], [fmtDate(a.date), null]],
  actions: editable ? '<a class="btn btn-light btn-icon" href="' + base + '/' + a._id + '/edit"><i class="bi bi-pencil"></i>' + t('Edit') + '</a>' : '' }) %>

<div class="card mb-3"><div class="card-body">
  <dl class="dl-grid mb-0">
    <div><dt><%= t('Type') %></dt><dd><%= t(C.ACTIVITY_TYPES[type]) %></dd></div>
    <% if (a.frequency) { %><div><dt><%= t('Frequency') %></dt><dd><%- statusBadge(a.frequency) %></dd></div><% } %>
    <div><dt><%= t('Class') %></dt><dd><%= a.class.name %></dd></div>
    <div><dt><%= t('Teacher') %></dt><dd><%= a.teacher ? a.teacher.fullName : '—' %></dd></div>
    <div><dt><%= t('Topic') %></dt><dd><%= a.topic || '—' %></dd></div>
  </dl>
  <div class="row g-3 mt-1">
    <div class="col-md-4"><div class="small-caps"><%= t('Objectives') %></div><p class="small mb-0" style="white-space:pre-line"><%= a.objectives || '—' %></p></div>
    <div class="col-md-4"><div class="small-caps"><%= t('Evaluation') %></div><p class="small mb-0" style="white-space:pre-line"><%= a.evaluation || '—' %></p></div>
    <div class="col-md-4"><div class="small-caps"><%= t('Remarks') %></div><p class="small mb-0" style="white-space:pre-line"><%= a.remarks || '—' %></p></div>
  </div>
</div></div>

<% if (usesDeductions) { %>
  <%- include('subac-scoring', { a: a, base: base, editable: editable, roster: roster }) %>
<% } else { %>
<form method="post" action="<%= base %>/<%= a._id %>/participation">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center"><span><%= t('Participants ({n})', { n: roster.length }) %></span><% if (editable && roster.length) { %><button class="btn btn-primary btn-sm" type="submit"><%= t('Save participation') %></button><% } %></div>
    <div class="table-responsive"><table class="table">
      <thead><tr><th><%= t('Student') %></th><th style="width:150px"><%= t('Attendance') %></th><th style="width:180px"><%= t('Performance') %></th><th style="width:100px"><%= t('Score') %></th><th><%= t('Remarks') %></th></tr></thead>
      <tbody>
        <% if (!roster.length) { %><tr><td colspan="5" class="empty-state"><%= t('No students in this class') %></td></tr><% } %>
        <% roster.forEach(function (r) { var p = r.part || {}; var k = 'rows[' + r.student._id + ']'; %>
          <tr>
            <td><a class="row-link" href="/school/students/<%= r.student._id %>"><%= r.student.fullName %></a></td>
            <td><select class="form-select form-select-sm" name="<%= k %>[attendance]" <%= editable ? '' : 'disabled' %>><% C.ATTENDANCE_STATUSES.forEach(function (s) { %><option value="<%= s %>" <%= selected(p.attendance || 'present', s) %>><%= titleCase(s) %></option><% }) %></select></td>
            <td><select class="form-select form-select-sm" name="<%= k %>[performance]" <%= editable ? '' : 'disabled' %>><option value="">—</option><% C.PERFORMANCE_LEVELS.forEach(function (x) { %><option value="<%= x %>" <%= selected(p.performance, x) %>><%= titleCase(x) %></option><% }) %></select></td>
            <td><input class="form-control form-control-sm" type="number" min="0" max="100" name="<%= k %>[score]" value="<%= p.score != null ? p.score : '' %>" <%= editable ? '' : 'disabled' %>></td>
            <td><input class="form-control form-control-sm" name="<%= k %>[remarks]" maxlength="500" value="<%= p.remarks || '' %>" <%= editable ? '' : 'disabled' %>></td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
  </div>
</form>
<% } %>
<% if (editable) { %>
<form method="post" action="<%= base %>/<%= a._id %>/delete" class="mt-3 text-end" data-confirm="<%= t('Delete this session and its participation records?') %>" data-confirm-button="<%= t('Delete') %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <button class="btn btn-outline-danger btn-sm" type="submit"><i class="bi bi-trash"></i> <%= t('Delete session') %></button>
</form>
<% } %>
