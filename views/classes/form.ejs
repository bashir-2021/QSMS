<% var c = cls || { isActive: true, capacity: 30, schedule: {} }; var editing = Boolean(cls); var days = (old.days ? [].concat(old.days) : (c.schedule && c.schedule.days) || []); %>
<%- include('../partials/page-header', { heading: editing ? 'Edit class' : 'New class', crumbs: [['Classes', '/school/classes'], [editing ? c.name : 'New', null]] }) %>

<form method="post" action="<%= editing ? '/school/classes/' + c._id : '/school/classes' %>" class="needs-validation" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="row g-3">
    <div class="col-lg-8">
      <div class="card mb-3"><div class="card-header"><%= t('Class') %></div><div class="card-body row g-3">
        <%- include('../partials/field', { name: 'name', label: 'Class name', value: c.name, required: true, col: 'col-md-6', placeholder: 'e.g. Hifz Group A' }) %>
        <%- include('../partials/field', { name: 'level', label: 'Level (Quran category)', ftype: 'select', value: c.level || 'cashra', placeholder: false, required: true, col: 'col-md-3', options: C.CLASS_LEVELS.map(function (l) { return { value: l, label: C.STUDENT_PROGRAMS[l] }; }) }) %>
        <%- include('../partials/field', { name: 'capacity', label: 'Capacity', ftype: 'number', value: c.capacity, min: 1, required: true, col: 'col-md-3' }) %>
        <% var classTeachers = (old.mainTeacher !== undefined ? [].concat(old.mainTeacher || [], old.teachers || []) : (c.teachers || [])).map(String); %>
        <%- include('../partials/field', { name: 'mainTeacher', label: 'Main teacher', ftype: 'select', value: classTeachers[0], col: 'col-md-6', placeholder: '— Not assigned —', options: teachers.map(function (tc) { return { value: tc._id, label: tc.fullName }; }) }) %>
        <div class="col-md-6">
          <div class="form-label"><%= t('Other teachers') %></div>
          <div class="border rounded p-2" style="max-height:10rem;overflow:auto">
            <% if (!teachers.length) { %><div class="small text-muted"><%= t('No teachers yet') %></div><% } %>
            <% teachers.forEach(function (tc) { var on = classTeachers.slice(1).indexOf(String(tc._id)) >= 0; %>
              <div class="form-check"><input class="form-check-input" type="checkbox" name="teachers" value="<%= tc._id %>" id="tch_<%= tc._id %>" <%= on ? 'checked' : '' %>><label class="form-check-label" for="tch_<%= tc._id %>"><%= tc.fullName %></label></div>
            <% }) %>
          </div>
          <div class="form-text"><%= t('Every teacher of the class can take attendance and give and listen to lessons.') %></div>
        </div>
        <%- include('../partials/field', { name: 'monthlyFee', label: 'Monthly fee (optional)', ftype: 'money', value: c.monthlyFee != null ? moneyInput(c.monthlyFee) : '', col: 'col-md-6', help: t('Leave empty to use the school fee of {fee}.', { fee: money(settings.monthlyFee, currency) }) }) %>
        <%- include('../partials/field', { name: 'startDate', label: 'Start date', ftype: 'date', value: isoDate(c.startDate), col: 'col-md-6' }) %>
        <%- include('../partials/field', { name: 'endDate', label: 'End date', ftype: 'date', value: isoDate(c.endDate), col: 'col-md-6' }) %>
        <%- include('../partials/field', { name: 'description', label: 'Description', ftype: 'textarea', value: c.description, rows: 2, max: 500 }) %>
      </div></div>
      <div class="card mb-3"><div class="card-header"><%= t('Schedule') %></div><div class="card-body row g-3">
        <div class="col-12"><label class="form-label"><%= t('Days') %></label><div class="d-flex flex-wrap gap-2">
          <% C.WEEKDAYS.forEach(function (d) { %>
            <input type="checkbox" class="btn-check" name="days" id="day_<%= d %>" value="<%= d %>" <%= days.indexOf(d) >= 0 ? 'checked' : '' %>>
            <label class="btn btn-outline-primary btn-sm" for="day_<%= d %>"><%= t(d) %></label>
          <% }) %>
        </div></div>
        <%- include('../partials/field', { name: 'startTime', label: 'Start time', ftype: 'time', value: c.schedule.startTime, col: 'col-md-4' }) %>
        <%- include('../partials/field', { name: 'endTime', label: 'End time', ftype: 'time', value: c.schedule.endTime, col: 'col-md-4' }) %>
        <%- include('../partials/field', { name: 'room', label: 'Room', value: c.schedule.room, col: 'col-md-4' }) %>
      </div></div>
    </div>
    <div class="col-lg-4"><div class="card"><div class="card-body d-grid gap-3">
      <%- include('../partials/field', { name: 'isActive', label: 'Class is active', ftype: 'checkbox', value: c.isActive }) %>
      <button class="btn btn-primary" type="submit"><%= t(editing ? 'Save changes' : 'Create class') %></button>
      <a class="btn btn-light" href="<%= editing ? '/school/classes/' + c._id : '/school/classes' %>"><%= t('Cancel') %></a>
    </div></div></div>
  </div>
</form>
