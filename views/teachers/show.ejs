<% var t = teacher; %>
<%- include('../partials/page-header', { heading: t.fullName, crumbs: [['Teachers', '/school/teachers'], [t.teacherCode, null]],
  actions: '<button class="btn btn-light btn-icon" type="button" data-print><i class="bi bi-printer"></i>Print</button>' +
    (can('teachers.manage') ? '<a class="btn btn-light btn-icon" href="/school/teachers/' + t._id + '/edit"><i class="bi bi-pencil"></i>Edit</a>' : '') +
    (can('salaries.manage') && hasFeature('expenses') ? '<a class="btn btn-primary btn-icon" href="/school/finance/salaries"><i class="bi bi-cash-stack"></i>Pay salary</a>' : '') }) %>

<div class="row g-3 mb-3">
  <div class="col-lg-8"><div class="card h-100"><div class="card-body d-flex gap-4 flex-wrap">
    <div class="avatar lg"><% if (t.photo) { %><img src="/school/files/<%= t.photo.split('/').pop() %>" alt=""><% } else { %><%= initials(t.fullName) %><% } %></div>
    <dl class="dl-grid flex-grow-1 mb-0">
      <div><dt>Teacher ID</dt><dd class="font-monospace"><%= t.teacherCode %></dd></div>
      <div><dt>Status</dt><dd><%- statusBadge(t.status) %></dd></div>
      <div><dt>Phone</dt><dd><%= t.phone || '—' %></dd></div>
      <div><dt>Email</dt><dd><%= t.email || '—' %></dd></div>
      <div><dt>Qualification</dt><dd><%= t.qualification || '—' %></dd></div>
      <div><dt>Specialization</dt><dd><%= t.specialization || '—' %></dd></div>
      <div><dt>Employed since</dt><dd><%= fmtDate(t.employmentDate) || '—' %></dd></div>
      <div><dt>Address</dt><dd><%= t.address || '—' %></dd></div>
    </dl>
  </div></div></div>
  <div class="col-lg-4"><div class="row g-3">
    <div class="col-6 col-lg-12"><div class="card stat-card"><div class="label">Classes &amp; students</div><div class="value"><%= classes.length %> <span class="fs-6 text-muted">classes</span></div><div class="meta"><%= studentCount %> active students</div></div></div>
    <% if (can('salaries.view')) { %><div class="col-6 col-lg-12"><div class="card stat-card"><div class="label">Monthly salary</div><div class="value"><%= money(t.monthlySalary, currency) %></div><div class="meta">Paid in last 24 months: <%= money(totalPaid, currency) %></div></div></div><% } %>
  </div></div>
</div>

<div class="row g-3">
  <div class="col-lg-6"><div class="card h-100"><div class="card-header">Assigned classes</div>
    <div class="list-group list-group-flush">
      <% if (!classes.length) { %><div class="empty-state small">No classes assigned</div><% } %>
      <% classes.forEach(function (c) { %><a class="list-group-item list-group-item-action d-flex justify-content-between" href="/school/classes/<%= c._id %>"><span><%= c.name %> <span class="text-muted small">· <%= c.level %></span></span><%- c.isActive ? '' : statusBadge('inactive') %></a><% }) %>
    </div>
  </div></div>
  <div class="col-lg-6"><div class="card h-100"><div class="card-header">Recent attendance</div>
    <div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Status</th><th>In / out</th></tr></thead><tbody>
      <% if (!attendance.length) { %><tr><td colspan="3" class="empty-state">No attendance recorded</td></tr><% } %>
      <% attendance.forEach(function (a) { %><tr><td><%= fmtDate(a.date) %></td><td><%- statusBadge(a.status) %></td><td class="small"><%= a.checkIn || '' %><%= a.checkOut ? ' – ' + a.checkOut : '' %></td></tr><% }) %>
    </tbody></table></div>
  </div></div>
  <% if (can('salaries.view')) { %>
  <div class="col-12"><div class="card"><div class="card-header">Salary payment history</div>
    <div class="table-responsive"><table class="table table-hover"><thead><tr><th>Month</th><th>Paid on</th><th>Method</th><th class="num">Base</th><th class="num">Bonus</th><th class="num">Deductions</th><th class="num">Net</th><th>Status</th></tr></thead><tbody>
      <% if (!salaries.length) { %><tr><td colspan="8" class="empty-state">No salary payments yet</td></tr><% } %>
      <% salaries.forEach(function (s) { %><tr><td><%= periodLabel(s.period) %></td><td><%= fmtDate(s.paymentDate) %></td><td><%= s.method %></td><td class="num"><%= money(s.baseSalary, currency) %></td><td class="num"><%= money(s.bonus, currency) %></td><td class="num"><%= money(s.deductions, currency) %></td><td class="num fw-semibold"><%= money(s.amount, currency) %></td><td><%- statusBadge(s.status) %></td></tr><% }) %>
    </tbody></table></div>
  </div></div>
  <% } %>
</div>
