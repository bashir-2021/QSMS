<% var tch = teacher; %>
<%- include('../partials/page-header', { heading: tch.fullName, crumbs: [['Teachers', '/school/teachers'], [tch.teacherCode, null]],
  actions: '<button class="btn btn-light btn-icon" type="button" data-print><i class="bi bi-printer"></i>' + t('Print') + '</button>' +
    (can('teachers.manage') ? '<a class="btn btn-light btn-icon" href="/school/teachers/' + tch._id + '/edit"><i class="bi bi-pencil"></i>' + t('Edit') + '</a>' : '') +
    (can('salaries.manage') && hasFeature('expenses') ? '<a class="btn btn-primary btn-icon" href="/school/finance/salaries"><i class="bi bi-cash-stack"></i>' + t('Pay salary') + '</a>' : '') }) %>

<div class="row g-3 mb-3">
  <div class="col-lg-8"><div class="card h-100"><div class="card-body d-flex gap-4 flex-wrap">
    <div class="avatar lg"><% if (tch.photo) { %><img src="/school/files/<%= tch.photo.split('/').pop() %>" alt=""><% } else { %><%= initials(tch.fullName) %><% } %></div>
    <dl class="dl-grid flex-grow-1 mb-0">
      <div><dt><%= t('Teacher ID') %></dt><dd class="font-monospace"><%= tch.teacherCode %></dd></div>
      <div><dt><%= t('Status') %></dt><dd><%- statusBadge(tch.status) %></dd></div>
      <div><dt><%= t('Phone') %></dt><dd><%= tch.phone || '—' %></dd></div>
      <div><dt><%= t('Email') %></dt><dd><%= tch.email || '—' %></dd></div>
      <div><dt><%= t('Qualification') %></dt><dd><%= tch.qualification || '—' %></dd></div>
      <div><dt><%= t('Specialization') %></dt><dd><%= tch.specialization || '—' %></dd></div>
      <div><dt><%= t('Employed since') %></dt><dd><%= fmtDate(tch.employmentDate) || '—' %></dd></div>
      <div><dt><%= t('Address') %></dt><dd><%= tch.address || '—' %></dd></div>
    </dl>
  </div></div></div>
  <div class="col-lg-4"><div class="row g-3">
    <div class="col-6 col-lg-12"><div class="card stat-card"><div class="label"><%= t('Classes & students') %></div><div class="value"><%= classes.length %> <span class="fs-6 text-muted"><%= classes.length === 1 ? t('class') : t('classes') %></span></div><div class="meta"><%= studentCount === 1 ? t('1 active student') : t('{n} active students', { n: studentCount }) %></div></div></div>
    <% if (can('salaries.view')) { %><div class="col-6 col-lg-12"><div class="card stat-card"><div class="label"><%= t('Monthly salary') %></div><div class="value"><%= money(tch.monthlySalary, currency) %></div><div class="meta"><%= t('Paid in last 24 months: {amount}', { amount: money(totalPaid, currency) }) %></div></div></div><% } %>
  </div></div>
</div>

<div class="row g-3">
  <div class="col-lg-6"><div class="card h-100"><div class="card-header"><%= t('Assigned classes') %></div>
    <div class="list-group list-group-flush">
      <% if (!classes.length) { %><div class="empty-state small"><%= t('No classes assigned') %></div><% } %>
      <% classes.forEach(function (c) { %><a class="list-group-item list-group-item-action d-flex justify-content-between" href="/school/classes/<%= c._id %>"><span><%= c.name %> <span class="text-muted small">· <%= t(c.level) %></span></span><%- c.isActive ? '' : statusBadge('inactive') %></a><% }) %>
    </div>
  </div></div>
  <div class="col-lg-6"><div class="card h-100"><div class="card-header"><%= t('Recent attendance') %></div>
    <div class="table-responsive"><table class="table"><thead><tr><th><%= t('Date') %></th><th><%= t('Status') %></th><th><%= t('In / out') %></th></tr></thead><tbody>
      <% if (!attendance.length) { %><tr><td colspan="3" class="empty-state"><%= t('No attendance recorded') %></td></tr><% } %>
      <% attendance.forEach(function (a) { %><tr><td><%= fmtDate(a.date) %></td><td><%- statusBadge(a.status) %></td><td class="small"><%= a.checkIn || '' %><%= a.checkOut ? ' – ' + a.checkOut : '' %></td></tr><% }) %>
    </tbody></table></div>
  </div></div>
  <% if (can('salaries.view')) { %>
  <div class="col-12"><div class="card"><div class="card-header"><%= t('Salary payment history') %></div>
    <div class="table-responsive"><table class="table table-hover"><thead><tr><th><%= t('Month') %></th><th><%= t('Paid on') %></th><th><%= t('Method') %></th><th class="num"><%= t('Base') %></th><th class="num"><%= t('Bonus') %></th><th class="num"><%= t('Deductions') %></th><th class="num"><%= t('Net') %></th><th><%= t('Status') %></th></tr></thead><tbody>
      <% if (!salaries.length) { %><tr><td colspan="8" class="empty-state"><%= t('No salary payments yet') %></td></tr><% } %>
      <% salaries.forEach(function (s) { %><tr><td><%= periodLabel(s.period) %></td><td><%= fmtDate(s.paymentDate) %></td><td><%= s.method %></td><td class="num"><%= money(s.baseSalary, currency) %></td><td class="num"><%= money(s.bonus, currency) %></td><td class="num"><%= money(s.deductions, currency) %></td><td class="num fw-semibold"><%= money(s.amount, currency) %></td><td><%- statusBadge(s.status) %></td></tr><% }) %>
    </tbody></table></div>
  </div></div>
  <% } %>
</div>
