<%- include('../partials/page-header', { heading: 'Teachers', sub: page.total + ' teachers',
  actions: (hasFeature('exports') ? '<a class="btn btn-light btn-icon" href="/school/teachers?format=xlsx"><i class="bi bi-file-earmark-excel"></i>Excel</a><a class="btn btn-light btn-icon" href="/school/teachers?format=pdf"><i class="bi bi-file-earmark-pdf"></i>PDF</a>' : '') +
    (can('teachers.manage') ? '<a class="btn btn-primary btn-icon" href="/school/teachers/new"><i class="bi bi-person-plus"></i>Add teacher</a>' : '') }) %>

<form class="filter-bar row g-2 align-items-end" method="get">
  <div class="col-md-6"><label class="form-label">Search</label><input class="form-control" name="search" value="<%= query.search || '' %>" placeholder="Name, ID, phone or specialization"></div>
  <div class="col-6 col-md-3"><label class="form-label">Status</label>
    <select class="form-select" name="status" data-autosubmit><option value="">All</option><% C.TEACHER_STATUSES.forEach(function (s) { %><option value="<%= s %>" <%= selected(query.status, s) %>><%= titleCase(s) %></option><% }) %></select></div>
  <div class="col-6 col-md-3 d-flex gap-2"><button class="btn btn-primary flex-fill" type="submit"><i class="bi bi-search"></i></button><a class="btn btn-light" href="/school/teachers">Reset</a></div>
</form>

<div class="card">
  <div class="table-responsive"><table class="table table-hover">
    <thead><tr><th>Teacher</th><th>ID</th><th>Phone</th><th>Specialization</th><th>Employed</th><% if (can('salaries.view')) { %><th class="num">Monthly salary</th><% } %><th>Status</th></tr></thead>
    <tbody>
      <% if (!page.items.length) { %><tr><td colspan="7"><div class="empty-state"><i class="bi bi-person-badge"></i>No teachers yet.</div></td></tr><% } %>
      <% page.items.forEach(function (t) { %>
        <tr>
          <td><div class="d-flex align-items-center gap-2"><span class="avatar"><% if (t.photo) { %><img src="/school/files/<%= t.photo.split('/').pop() %>" alt=""><% } else { %><%= initials(t.fullName) %><% } %></span>
            <div><a class="row-link" href="/school/teachers/<%= t._id %>"><%= t.fullName %></a><div class="small text-muted"><%= t.qualification || '' %></div></div></div></td>
          <td class="font-monospace small"><%= t.teacherCode %></td><td><%= t.phone %></td><td><%= t.specialization || '—' %></td><td><%= fmtDate(t.employmentDate) || '—' %></td>
          <% if (can('salaries.view')) { %><td class="num"><%= money(t.monthlySalary, currency) %></td><% } %>
          <td><%- statusBadge(t.status) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table></div>
  <%- include('../partials/pagination', { page: page }) %>
</div>
