<% var tch = teacher || {}; var editing = Boolean(teacher); %>
<%- include('../partials/page-header', { heading: editing ? 'Edit teacher' : 'Add teacher', crumbs: [['Teachers', '/school/teachers'], [editing ? tch.fullName : 'New', null]] }) %>

<form method="post" action="<%= editing ? '/school/teachers/' + tch._id : '/school/teachers' %>?_csrf=<%= csrfToken %>" enctype="multipart/form-data" class="needs-validation" novalidate>
  <div class="row g-3">
    <div class="col-lg-8">
      <div class="card mb-3"><div class="card-header"><%= t('Personal information') %></div><div class="card-body row g-3">
        <%- include('../partials/field', { name: 'fullName', label: 'Full name', value: tch.fullName, required: true, col: 'col-md-8' }) %>
        <%- include('../partials/field', { name: 'gender', label: 'Gender', ftype: 'select', value: tch.gender, col: 'col-md-4', options: C.GENDERS.map(function (g) { return { value: g, label: titleCase(g) }; }) }) %>
        <%- include('../partials/field', { name: 'phone', label: 'Phone', ftype: 'tel', value: tch.phone, required: true, col: 'col-md-4' }) %>
        <%- include('../partials/field', { name: 'email', label: 'Email', ftype: 'email', value: tch.email, col: 'col-md-4' }) %>
        <%- include('../partials/field', { name: 'dateOfBirth', label: 'Date of birth', ftype: 'date', value: isoDate(tch.dateOfBirth), col: 'col-md-4' }) %>
        <%- include('../partials/field', { name: 'address', label: 'Address', value: tch.address }) %>
      </div></div>
      <div class="card mb-3"><div class="card-header"><%= t('Employment') %></div><div class="card-body row g-3">
        <%- include('../partials/field', { name: 'qualification', label: 'Qualification', value: tch.qualification, col: 'col-md-6', placeholder: 'e.g. Hafiz, Ijazah in Hafs' }) %>
        <%- include('../partials/field', { name: 'specialization', label: 'Specialization', value: tch.specialization, col: 'col-md-6', placeholder: 'e.g. Tajweed, Hifz' }) %>
        <%- include('../partials/field', { name: 'employmentDate', label: 'Employment date', ftype: 'date', value: isoDate(tch.employmentDate), col: 'col-md-4' }) %>
        <%- include('../partials/field', { name: 'monthlySalary', label: 'Monthly salary', ftype: 'money', value: tch.monthlySalary != null ? moneyInput(tch.monthlySalary) : '', col: 'col-md-4' }) %>
        <%- include('../partials/field', { name: 'status', label: 'Employment status', ftype: 'select', value: tch.status || 'active', placeholder: false, col: 'col-md-4', options: C.TEACHER_STATUSES.map(function (x) { return { value: x, label: titleCase(x) }; }) }) %>
        <%- include('../partials/field', { name: 'notes', label: 'Notes', ftype: 'textarea', value: tch.notes, rows: 2, max: 500 }) %>
      </div></div>
    </div>
    <div class="col-lg-4">
      <div class="card mb-3"><div class="card-header"><%= t('Photo') %></div><div class="card-body text-center">
        <img id="photoPreview" class="rounded-4 mb-3 <%= tch.photo ? '' : 'd-none' %>" style="width:140px;height:140px;object-fit:cover" src="<%= tch.photo ? '/school/files/' + tch.photo.split('/').pop() : '' %>" alt="">
        <input type="file" class="form-control" name="photo" accept="image/png,image/jpeg,image/webp" data-preview="#photoPreview">
      </div></div>
      <div class="card"><div class="card-body d-grid gap-2">
        <button class="btn btn-primary" type="submit"><%= t(editing ? 'Save changes' : 'Add teacher') %></button>
        <a class="btn btn-light" href="<%= editing ? '/school/teachers/' + tch._id : '/school/teachers' %>"><%= t('Cancel') %></a>
      </div></div>
    </div>
  </div>
</form>
