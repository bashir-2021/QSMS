<div class="auth-wrap" style="min-height:auto">
  <div class="auth-card">
    <h1 class="h4 mb-1"><%= t(first ? 'Choose your own password' : 'Change password') %></h1>
    <p class="text-muted small"><%= t(first ? 'For your safety, replace the first password (your phone number) before continuing.' : 'Use at least 8 characters with a letter and a number.') %></p>
    <div class="card"><div class="card-body p-4">
      <form method="post" action="/parent/password" class="row g-3 needs-validation" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (!first) { %><%- include('../partials/field', { name: 'currentPassword', label: 'Current password', ftype: 'password', required: true, attrs: 'autocomplete="current-password"' }) %><% } %>
        <%- include('../partials/field', { name: 'newPassword', label: 'New password', ftype: 'password', required: true, help: 'Use at least 8 characters with a letter and a number.', attrs: 'autocomplete="new-password" minlength="8"' }) %>
        <%- include('../partials/field', { name: 'confirmPassword', label: 'Confirm new password', ftype: 'password', required: true, attrs: 'autocomplete="new-password" minlength="8"' }) %>
        <div class="col-12"><button class="btn btn-primary w-100" type="submit"><%= t('Save password') %></button></div>
      </form>
    </div></div>
    <% if (!first) { %><p class="text-center small mt-3"><a href="/parent"><%= t('Back') %></a></p><% } %>
  </div>
</div>
