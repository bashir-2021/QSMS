# ---- Server ----
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ---- Database ----
# Production MUST be a replica set or sharded cluster so financial transactions work.
# Local single-node replica set example: mongod --replSet rs0  then  rs.initiate()
MONGO_URI=mongodb://127.0.0.1:27017/quranic?replicaSet=rs0
# Set to false only for local development against a standalone mongod (no transactions).
MONGO_TRANSACTIONS=true

# ---- Sessions ----
# Use a long random string (e.g. `openssl rand -hex 48`)
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_MAX_AGE_HOURS=8
# Set to true behind HTTPS (required in production)
COOKIE_SECURE=false
TRUST_PROXY=false

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_IMAGE_MB=2
MAX_ATTACHMENT_MB=5

# ---- Subscription policy ----
# What an expired school (past grace period) may do: "read_only" or "blocked"
EXPIRED_ACCESS_POLICY=read_only
# Days before expiry that a subscription is shown as "Expiring Soon"
EXPIRING_SOON_DAYS=7
# How often the background job refreshes subscription states / reminders (minutes)
JOB_INTERVAL_MINUTES=60

# ---- First super admin (used by `npm run create-superadmin`) ----
SUPERADMIN_NAME=Platform Owner
SUPERADMIN_EMAIL=admin@quranic.app
SUPERADMIN_PASSWORD=ChangeMe!2026

# ---- Backups ----
BACKUP_DIR=backups
